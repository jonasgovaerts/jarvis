# Copy to .env (gitignored). Services read config exclusively via pydantic-settings,
# so local and in-cluster (Secret/ConfigMap env) are one code path.

NATS_URL=nats://localhost:4222
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# LiteLLM proxy (docker compose)
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=anything-local
LLM_DEFAULT_MODEL=claude-sonnet

# Provider keys — consumed by the LiteLLM container only (docker compose passthrough)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gateway
JARVIS_TOKEN=dev-token
FAKE_K8S=false
